{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": { "includes": ["**", "!dist", "!etc", "!dev/app", "!dev/payload-types.ts", "!**/*.tsbuildinfo", "!temp"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all" } },
  "linter": { "enabled": true, "rules": { "recommended": true } }
}
