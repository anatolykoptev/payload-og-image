{
  "name": "payload-og-image",
  "version": "0.8.0",
  "description": "Payload CMS plugin: generated, content-versioned Open Graph share cards with a crash-safe store and a test kit.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/anatolykoptev/payload-og-image#readme",
  "bugs": {
    "url": "https://github.com/anatolykoptev/payload-og-image/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "open-graph",
    "og-image",
    "share-card",
    "nextjs"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolykoptev/payload-og-image.git"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs",
    "skills",
    "!docs/INDEX.md",
    "NOTICE"
  ],
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js"
    },
    "./next": {
      "types": "./dist/exports/next.d.ts",
      "import": "./dist/exports/next.js"
    },
    "./mcp": {
      "types": "./dist/exports/mcp.d.ts",
      "import": "./dist/exports/mcp.js"
    },
    "./mcp/v3": {
      "types": "./dist/exports/mcp-v3.d.ts",
      "import": "./dist/exports/mcp-v3.js"
    },
    "./testing": {
      "types": "./dist/exports/testing.d.ts",
      "import": "./dist/exports/testing.js"
    }
  },
  "bin": {
    "og-parity": "dist/testing/parity.js"
  },
  "scripts": {
    "api:check": "api-extractor run -c api-extractor.json && api-extractor run -c api-extractor.next.json && api-extractor run -c api-extractor.testing.json && api-extractor run -c api-extractor.mcp.json && api-extractor run -c api-extractor.mcpv3.json && api-extractor run -c api-extractor.client.json",
    "api:update": "api-extractor run --local -c api-extractor.json && api-extractor run --local -c api-extractor.next.json && api-extractor run --local -c api-extractor.testing.json && api-extractor run --local -c api-extractor.mcp.json && api-extractor run --local -c api-extractor.mcpv3.json && api-extractor run --local -c api-extractor.client.json",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "next dev dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p dev/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.93.0 || ^4.0.0-beta.12",
    "@typescript/typescript6": "^6.0.2",
    "next": "^16.4.5",
    "payload": "^3.93.0 || ^4.0.0-beta.12",
    "react": "^19.3.1",
    "sharp": "^0.35.4",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.50"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    },
    "@typescript/typescript6": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@microsoft/api-extractor": "7.60.1",
    "@payloadcms/db-sqlite": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/plugin-mcp": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "graphql": "16.15.0",
    "jsdom": "31.0.1",
    "next": "16.4.6",
    "payload": "3.94.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "3.25.76"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "fontkit": "3.0.0"
  }
}
