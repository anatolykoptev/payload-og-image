{
  "name": "payload-og-image",
  "version": "0.0.0",
  "description": "Payload CMS plugin: generated, content-versioned Open Graph share cards with a crash-safe store and a test kit.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolykoptev/payload-og-image.git"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./next": {
      "types": "./dist/exports/next.d.ts",
      "import": "./dist/exports/next.js"
    },
    "./testing": {
      "types": "./dist/exports/testing.d.ts",
      "import": "./dist/exports/testing.js"
    }
  },
  "bin": {
    "og-parity": "./dist/testing/parity.js"
  },
  "scripts": {
    "api:check": "api-extractor run -c api-extractor.json && api-extractor run -c api-extractor.next.json && api-extractor run -c api-extractor.testing.json",
    "api:update": "api-extractor run --local -c api-extractor.json && api-extractor run --local -c api-extractor.next.json && api-extractor run --local -c api-extractor.testing.json",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "next dev dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^16.4.5",
    "payload": "^3.93.0",
    "react": "^19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@microsoft/api-extractor": "7.60.1",
    "@payloadcms/db-sqlite": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.94.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
